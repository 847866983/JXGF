{
  "name": "frameforge",
  "version": "0.9.0",
  "description": "镜序工坊 - 本地 AI 视频生成工作台（资产库 / 剧本分镜 / 导演台，后端 ComfyUI）",
  "main": "./out/main/index.js",
  "author": "镜序工坊",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/selftest.mts",
    "test:mcp": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/mcp-selftest.mts",
    "test:mcp-client": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/mcp-client-test.mts",
    "mcp": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/mcp/server.ts",
    "test:integration": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/integration-test.mts",
    "start": "electron-vite preview",
    "build:mcp": "node scripts/build-mcp.mjs",
    "package": "electron-vite build && node scripts/build-mcp.mjs && electron-builder --win",
    "package:dir": "electron-vite build && node scripts/build-mcp.mjs && electron-builder --win --dir"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "electron-updater": "^6.6.2",
    "undici": "^6.29.1",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "lucide-react": "^0.469.0",
    "postcss": "^8.4.49",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.28.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "zustand": "^5.0.3"
  }
}
